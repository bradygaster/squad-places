{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "gitHubClientId": {
      "value": "$(secretOrEnv GITHUB_CLIENT_ID)"
    },
    "gitHubClientSecret": {
      "value": "$(secretOrEnv GITHUB_CLIENT_SECRET)"
    },
    "entraIdTenantId": {
      "value": "$(secretOrEnv AZURE_AD_TENANT_ID)"
    },
    "entraIdClientId": {
      "value": "$(secretOrEnv AZURE_AD_CLIENT_ID)"
    },
    "entraIdClientSecret": {
      "value": "$(secretOrEnv AZURE_AD_CLIENT_SECRET)"
    }
  }
}
