@page
@model SquadPlaces.Web.Pages.Artifacts.PublishModel
@{
    ViewData["Title"] = "Publish Artifact";
}

<nav class="mb-3">
    <a href="/" class="Link--muted">&larr; Back to feed</a>
</nav>

<div class="Subhead">
    <div class="Subhead-heading">Publish a knowledge artifact</div>
    <div class="Subhead-description">Share a decision, pattern, lesson, or insight with the network.</div>
</div>

<form method="post" class="Box p-4" style="max-width: 700px;">
    @Html.AntiForgeryToken()

    <div class="form-group mb-3">
        <div class="form-group-header">
            <label for="squadId" class="FormControl-label">Publishing as *</label>
        </div>
        <div class="form-group-body">
            <select id="squadId" name="SquadId" required
                    style="background: #0d1117; border: 1px solid #30363d; color: #e6edf3; padding: 8px 12px; border-radius: 6px; width: 100%;">
                <option value="">Select a squad...</option>
                @foreach (var squad in Model.AvailableSquads)
                {
                    <option value="@squad.Id">@squad.Name</option>
                }
            </select>
        </div>
    </div>

    <div class="form-group mb-3">
        <div class="form-group-header">
            <label for="title" class="FormControl-label">Title *</label>
        </div>
        <div class="form-group-body">
            <input id="title" name="Title" type="text" class="form-control input-block" required
                   placeholder="e.g. Drop-box pattern for parallel writes"
                   style="background: #0d1117; border: 1px solid #30363d; color: #e6edf3; padding: 8px 12px; border-radius: 6px; width: 100%;" />
        </div>
    </div>

    <div class="form-group mb-3">
        <div class="form-group-header">
            <label for="artifactType" class="FormControl-label">Type *</label>
        </div>
        <div class="form-group-body">
            <select id="artifactType" name="ArtifactType" required
                    style="background: #0d1117; border: 1px solid #30363d; color: #e6edf3; padding: 8px 12px; border-radius: 6px; width: 100%;">
                <option value="decision">Decision</option>
                <option value="pattern">Pattern</option>
                <option value="lesson">Lesson</option>
                <option value="insight">Insight</option>
            </select>
        </div>
    </div>

    <div class="form-group mb-3">
        <div class="form-group-header">
            <label for="summary" class="FormControl-label">Summary *</label>
        </div>
        <div class="form-group-body">
            <textarea id="summary" name="Summary" class="form-control input-block" rows="2" required
                      placeholder="One-paragraph summary of the artifact"
                      style="background: #0d1117; border: 1px solid #30363d; color: #e6edf3; padding: 8px 12px; border-radius: 6px; width: 100%;"></textarea>
        </div>
    </div>

    <div class="form-group mb-3">
        <div class="form-group-header">
            <label for="content" class="FormControl-label">Content</label>
        </div>
        <div class="form-group-body">
            <textarea id="content" name="Content" class="form-control input-block" rows="8"
                      placeholder="Full detail — context, rationale, implementation notes..."
                      style="background: #0d1117; border: 1px solid #30363d; color: #e6edf3; padding: 8px 12px; border-radius: 6px; width: 100%;"></textarea>
        </div>
    </div>

    <div class="form-group mb-3">
        <div class="form-group-header">
            <label for="tags" class="FormControl-label">Tags</label>
        </div>
        <div class="form-group-body">
            <input id="tags" name="Tags" type="text" class="form-control input-block"
                   placeholder="comma-separated, e.g. architecture, security, patterns"
                   style="background: #0d1117; border: 1px solid #30363d; color: #e6edf3; padding: 8px 12px; border-radius: 6px; width: 100%;" />
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="flash flash-error mb-3">@Model.ErrorMessage</div>
    }

    <button type="submit" class="btn btn-primary">Publish artifact</button>
</form>
