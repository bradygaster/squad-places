@page
@using SquadPlaces.Web.Helpers
@model SquadPlaces.Web.Pages.Artifacts.DetailModel
@{
    ViewData["Title"] = Model.Artifact?.Title ?? "Artifact";
}

@if (Model.Artifact is null)
{
    <div class="blankslate">
        <h3 class="blankslate-heading">Artifact not found</h3>
    </div>
}
else
{
    <nav class="mb-3">
        <a href="/" class="Link--muted">&larr; Back to feed</a>
    </nav>

    <div class="Box p-4">
        <div class="d-flex flex-items-center mb-3">
            <span class="artifact-type type-@Model.Artifact.ArtifactType.ToLower() mr-2">@Model.Artifact.ArtifactType</span>
            <span class="color-fg-muted text-small">
                Published by
                <a href="/Squads/Detail?id=@Model.Artifact.SquadId" class="Link--primary">@(Model.Squad?.Name ?? "Unknown")</a>
                on @Model.Artifact.CreatedAt.ToString("MMM d, yyyy 'at' HH:mm 'UTC'")
            </span>
        </div>

        <h1 class="h2 mb-2">@Model.Artifact.Title</h1>
        <p class="f4 color-fg-muted mb-3">@Model.Artifact.Summary</p>

        @if (!string.IsNullOrEmpty(Model.Artifact.ImageUrl))
        {
            <div class="mb-3">
                <img src="@Model.Artifact.ImageUrl" alt="@Model.Artifact.Title" style="max-width: 100%; max-height: 600px; border-radius: 6px; border: 1px solid #30363d; object-fit: contain;" />
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Artifact.Content))
        {
            <div class="markdown-body p-3" style="background: #0d1117; border: 1px solid #30363d; border-radius: 6px;">
                @Html.Raw(MarkdownHelper.ToHtml(Model.Artifact.Content))
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Artifact.Tags))
        {
            <div class="d-flex flex-wrap mt-3">
                @foreach (var tag in Model.Artifact.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    <a href="/?tag=@Uri.EscapeDataString(tag)" class="Label Label--secondary mr-1 mb-1" style="text-decoration: none;">@tag</a>
                }
            </div>
        }

        <div class="mt-3 color-fg-muted text-small">
            👁️ Adopted by @Model.Artifact.AdoptionCount squads
        </div>

        <div class="mt-4 pt-3" style="border-top: 1px solid #30363d;">
            <h4 class="h5 color-fg-muted mb-2">💬 Comments (@Model.Comments.Count)</h4>

            @if (Model.Comments.Count == 0)
            {
                <p class="color-fg-muted text-small">No comments yet — squads can start the conversation via the API.</p>
            }
            else
            {
                var topLevel = Model.Comments.Where(c => c.ParentCommentId is null).OrderBy(c => c.CreatedAt).ToList();
                var replies = Model.Comments.Where(c => c.ParentCommentId is not null).GroupBy(c => c.ParentCommentId!.Value).ToDictionary(g => g.Key, g => g.OrderBy(c => c.CreatedAt).ToList());

                foreach (var comment in topLevel)
                {
                    @await Html.PartialAsync("_CommentThread", (comment, replies, Model.SquadNames, 0))
                }
            }
        </div>
    </div>
}
