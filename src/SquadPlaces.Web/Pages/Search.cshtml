@page
@model SquadPlaces.Web.Pages.SearchModel
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.Query) ? "Hackathon Search" : $"Hackathon Search: {Model.Query}";
}

<div class="d-flex flex-items-center flex-justify-between mb-4">
    <div>
        <h1 class="h2 text-normal">Hackathon Search</h1>
        @if (!string.IsNullOrEmpty(Model.Query))
        {
            <p class="color-fg-muted">
                <span class="Counter mr-1">@Model.ResultCount</span>
                result@(Model.ResultCount != 1 ? "s" : "") for "<span class="text-bold">@Model.Query</span>"
            </p>
        }
        else
        {
            <p class="color-fg-muted">Enter a search term to find briefs, directives, submissions, repositories, or tags</p>
        }
    </div>
</div>

<form method="get" action="/Search" class="mb-4">
    <div class="d-flex flex-items-center">
        <input type="text" name="q" value="@Model.Query" placeholder="Search briefs, directives, summaries, content, repositories, or tags..."
               class="form-control mr-2"
               style="background: #0d1117; border-color: #30363d; color: #e6edf3;"
               required autofocus />
        <button type="submit" class="btn">Search</button>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Query) && Model.ResultCount == 0)
{
    <div class="blankslate">
        <h3 class="blankslate-heading">No results</h3>
        <p>No items found matching "@Model.Query"</p>
    </div>
}
else if (Model.ResultCount > 0)
{
    @foreach (var result in Model.Results)
    {
        <div class="feed-item">
            <div class="d-flex flex-items-center mb-2">
                <span class="artifact-type type-@result.ResultType.ToLower() mr-2">@result.ResultType</span>
                @if (result.SquadId.HasValue && Model.SquadNames.TryGetValue(result.SquadId.Value, out var squadName))
                {
                    <a href="/Squads/Detail?id=@result.SquadId" class="Link--primary text-bold mr-2">@squadName</a>
                }
                <span class="color-fg-muted text-small ml-auto">@result.CreatedAt.ToString("MMM d, yyyy")</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(result.Url))
            {
                <a href="@result.Url" class="Link--primary">
                    <h3 class="h4 mb-1">@result.Title</h3>
                </a>
            }
            else
            {
                <h3 class="h4 mb-1">@result.Title</h3>
            }
            <p class="color-fg-muted mb-2">@result.Summary</p>
            <div class="d-flex flex-items-center flex-wrap">
                @if (!string.IsNullOrWhiteSpace(result.Tags))
                {
                    foreach (var tag in result.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        <span class="Label Label--secondary mr-1 mb-1">@tag</span>
                    }
                }
                @if (result.KnowledgeArtifactId.HasValue)
                {
                    <span class="color-fg-muted text-small ml-auto">💬 @Model.CommentCounts.GetValueOrDefault(result.KnowledgeArtifactId.Value, 0)</span>
                }
            </div>
        </div>
    }
}
