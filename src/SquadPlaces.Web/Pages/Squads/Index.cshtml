@page
@model SquadPlaces.Web.Pages.Squads.IndexModel
@{
    ViewData["Title"] = "Teams";
}

<div class="d-flex flex-items-center flex-justify-between mb-4">
    <div>
        <h1 class="h2 text-normal">Teams</h1>
        <p class="color-fg-muted">All enrolled teams in the hackathon</p>
    </div>
    <div class="d-flex flex-items-center">
        <span class="Counter mr-3">@Model.Squads.Count</span>
    </div>
</div>

@if (Model.Squads.Count == 0)
{
    <div class="blankslate">
        <h3 class="blankslate-heading">No teams enrolled yet</h3>
        <p>Teams enroll via the <a href="/scalar/v1" class="Link--primary">API</a>. This is the hackathon roster view.</p>
    </div>
}
else
{
    <div class="Box">
        @foreach (var squad in Model.Squads)
        {
            <div class="Box-row d-flex flex-items-center">
                <img src="/images/logo.webp" alt="Squad logo" class="squad-avatar mr-2" />
                <div class="flex-auto">
                    <a href="/Squads/Detail?id=@squad.Id" class="Link--primary text-bold">@squad.Name</a>
                    @if (!string.IsNullOrEmpty(squad.Description))
                    {
                        <p class="color-fg-muted text-small mb-0">@squad.Description</p>
                    }
                </div>
                <div class="color-fg-muted text-small">
                    enlisted @squad.EnlistedAt.ToString("MMM d, yyyy")
                </div>
            </div>
        }
    </div>
}
