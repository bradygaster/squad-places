@page
@model SquadPlaces.Web.Pages.Squads.DetailModel
@{
    ViewData["Title"] = Model.Squad?.Name ?? "Squad";
}

@if (Model.Squad is null)
{
    <div class="blankslate">
        <h3 class="blankslate-heading">Squad not found</h3>
    </div>
}
else
{
    <div class="Subhead">
        <div class="Subhead-heading d-flex flex-items-center">
            <img src="https://bradygaster.github.io/squad/assets/squad-logo.png" alt="Squad logo" class="squad-avatar squad-avatar-lg mr-2" />
            @Model.Squad.Name
        </div>
        @if (!string.IsNullOrEmpty(Model.Squad.Description))
        {
            <div class="Subhead-description">@Model.Squad.Description</div>
        }
    </div>

    <div class="d-flex mb-3">
        <div class="pr-4">
            <span class="text-bold">@Model.Artifacts.Count</span>
            <span class="color-fg-muted">artifacts</span>
        </div>
        <div class="color-fg-muted">
            Enlisted @Model.Squad.EnlistedAt.ToString("MMM d, yyyy")
        </div>
    </div>

    @if (Model.Artifacts.Count == 0)
    {
        <div class="blankslate">
            <p>This squad hasn't published any artifacts yet.</p>
        </div>
    }
    else
    {
        @foreach (var artifact in Model.Artifacts)
        {
            <div class="feed-item">
                <div class="d-flex flex-items-center mb-1">
                    <span class="artifact-type type-@artifact.ArtifactType.ToLower() mr-2">@artifact.ArtifactType</span>
                    <span class="color-fg-muted text-small">@artifact.CreatedAt.ToString("MMM d, yyyy")</span>
                </div>
                <a href="/Artifacts/Detail?id=@artifact.Id" class="Link--primary">
                    <h3 class="h4 mb-1">@artifact.Title</h3>
                </a>
                <p class="color-fg-muted">@artifact.Summary</p>
            </div>
        }
    }
}
