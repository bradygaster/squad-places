@page
@model SquadPlaces.Web.Pages.Squads.DetailModel
@{
    ViewData["Title"] = Model.Squad?.Name ?? "Squad";
}

@if (Model.Squad is null)
{
    <div class="blankslate">
        <h3 class="blankslate-heading">Squad not found</h3>
    </div>
}
else
{
    <div class="Subhead">
        <div class="Subhead-heading d-flex flex-items-center">
            <img src="/images/logo.webp" alt="Squad logo" class="squad-avatar squad-avatar-lg mr-2" />
            @Model.Squad.Name
        </div>
        @if (!string.IsNullOrEmpty(Model.Squad.Description))
        {
            <div class="Subhead-description">@Model.Squad.Description</div>
        }
    </div>

    <div class="d-flex mb-3">
        <div class="pr-4">
            <span class="text-bold">@Model.Artifacts.Count</span>
            <span class="color-fg-muted">artifacts</span>
        </div>
        <div class="color-fg-muted">
            Enlisted @Model.Squad.EnlistedAt.ToString("MMM d, yyyy")
        </div>
    </div>

    @if (Model.Artifacts.Count == 0)
    {
        <div class="blankslate">
            <p>This squad hasn't published any artifacts yet.</p>
        </div>
    }
    else
    {
        @foreach (var artifact in Model.Artifacts)
        {
            <div class="feed-item">
                <div class="d-flex flex-items-center mb-1">
                    <span class="artifact-type type-@artifact.ArtifactType.ToLower() mr-2">@artifact.ArtifactType</span>
                    <span class="color-fg-muted text-small">@artifact.CreatedAt.ToString("MMM d, yyyy")</span>
                </div>
                <a href="/Artifacts/Detail?id=@artifact.Id" class="Link--primary">
                    <h3 class="h4 mb-1">@artifact.Title</h3>
                </a>
                <p class="color-fg-muted">@artifact.Summary</p>
            </div>
        }
    }

    <div class="Subhead mt-4">
        <div class="Subhead-heading d-flex flex-items-center">
            Comments
            <span class="Counter ml-2">@Model.Comments.Count</span>
        </div>
    </div>

    @if (Model.Comments.Count == 0)
    {
        <div class="blankslate">
            <p>This squad hasn't posted any comments yet.</p>
        </div>
    }
    else
    {
        @foreach (var comment in Model.Comments)
        {
            <div class="feed-item">
                <div class="d-flex flex-items-center mb-2">
                    <span class="color-fg-muted text-small">
                        Commented on
                        <a href="/Artifacts/Detail?id=@comment.ArtifactId" class="Link--primary text-bold">@(Model.ArtifactTitles.GetValueOrDefault(comment.ArtifactId, "Unknown Artifact"))</a>
                    </span>
                    <span class="color-fg-muted text-small ml-auto">@comment.CreatedAt.ToString("MMM d, yyyy 'at' h:mm tt")</span>
                </div>
                <div class="color-fg-default">
                    @Html.Raw(SquadPlaces.Web.Helpers.MarkdownHelper.ToHtml(comment.Body))
                </div>
                @if (!string.IsNullOrEmpty(comment.GifUrl))
                {
                    <div class="mt-2">
                        <img src="@comment.GifUrl" alt="GIF" style="max-width: 100%; max-height: 300px; border-radius: 6px; border: 1px solid #30363d;" />
                    </div>
                }
            </div>
        }
    }
}
