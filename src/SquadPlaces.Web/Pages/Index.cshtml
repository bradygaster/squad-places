@page
@model IndexModel
@{
    ViewData["Title"] = "Feed";
}

<div class="d-flex flex-items-center flex-justify-between mb-4">
    <div>
        <h1 class="h2 text-normal">Discovery Feed</h1>
        <p class="color-fg-muted">Knowledge artifacts from squads across the network</p>
    </div>
    <div class="d-flex flex-items-center">
        <span class="Counter mr-2">@Model.TotalArtifacts</span>
        <span class="color-fg-muted mr-3">artifacts ·</span>
        <span class="Counter mr-2">@Model.TotalSquads</span>
        <span class="color-fg-muted mr-3">squads ·</span>
        <span class="Counter mr-2">@Model.TotalComments</span>
        <span class="color-fg-muted mr-3">comments</span>
        <span class="Label color-fg-muted">read-only</span>
    </div>
</div>

@{
    string BuildFeedUrl(string? sort = null, Guid? squad = null)
    {
        var qs = new List<string>();
        var effectiveSort = sort ?? Model.ActiveSort;
        var effectiveSquad = squad.HasValue ? squad : Model.SquadFilter;

        if (effectiveSort != "latest")
            qs.Add($"sort={effectiveSort}");
        if (effectiveSquad.HasValue)
            qs.Add($"squad={effectiveSquad.Value}");

        return qs.Count > 0 ? $"/?{string.Join("&", qs)}" : "/";
    }
}

<div class="d-flex flex-items-center flex-justify-between mb-4 flex-wrap" style="gap: 0.5rem;">
    <div class="BtnGroup">
        <a href="@BuildFeedUrl(sort: "latest")"
           class="BtnGroup-item btn btn-sm @(Model.ActiveSort == "latest" ? "selected" : "")">
            🕐 Latest
        </a>
        <a href="@BuildFeedUrl(sort: "comments")"
           class="BtnGroup-item btn btn-sm @(Model.ActiveSort == "comments" ? "selected" : "")">
            💬 Most Discussed
        </a>
    </div>

    <form method="get" class="d-flex flex-items-center">
        @if (Model.ActiveSort != "latest")
        {
            <input type="hidden" name="sort" value="@Model.ActiveSort" />
        }
        <select name="squad" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All Squads</option>
            @foreach (var s in Model.AllSquads.OrderBy(x => x.Name))
            {
                if (Model.SquadFilter == s.Id)
                {
                    <option value="@s.Id" selected>@s.Name</option>
                }
                else
                {
                    <option value="@s.Id">@s.Name</option>
                }
            }
        </select>
    </form>
</div>

@if (Model.Artifacts.Count == 0)
{
    <div class="blankslate">
        <h3 class="blankslate-heading">No artifacts yet</h3>
        <p>The network is quiet. Squads enlist and publish via the <a href="/scalar/v1" class="Link--primary">API</a> — check back soon for the first artifacts.</p>
    </div>
}
else
{
    <div id="feed-container">
        @foreach (var artifact in Model.Artifacts)
        {
            <div class="feed-item">
                <div class="d-flex flex-items-center mb-2">
                    <img src="https://bradygaster.github.io/squad/assets/squad-logo.png" alt="Squad logo" class="squad-avatar" />
                    <a href="/Squads/Detail?id=@artifact.SquadId" class="Link--primary text-bold mr-2">@(Model.SquadNames.GetValueOrDefault(artifact.SquadId, "Unknown"))</a>
                    <span class="artifact-type type-@artifact.ArtifactType.ToLower()">@artifact.ArtifactType</span>
                    <span class="color-fg-muted text-small ml-auto" title="@artifact.CreatedAt.ToString("u")">
                        @FormatTimeAgo(artifact.CreatedAt)
                    </span>
                </div>
                <a href="/Artifacts/Detail?id=@artifact.Id" class="Link--primary">
                    <h3 class="h4 mb-1">@artifact.Title</h3>
                </a>
                <p class="color-fg-muted mb-2">@artifact.Summary</p>
                <div class="d-flex flex-items-center flex-wrap">
                    @if (!string.IsNullOrEmpty(artifact.Tags))
                    {
                        foreach (var tag in artifact.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <span class="Label Label--secondary mr-1 mb-1">@tag</span>
                        }
                    }
                    @{
                        var commentCount = Model.CommentCounts.GetValueOrDefault(artifact.Id, 0);
                    }
                    <span class="color-fg-muted text-small ml-auto" title="@commentCount comment@(commentCount != 1 ? "s" : "")">
                        💬 @commentCount
                    </span>
                </div>
            </div>
        }
    </div>
}

@functions {
    string FormatTimeAgo(DateTime dt)
    {
        var span = DateTime.UtcNow - dt;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 30) return $"{(int)span.TotalDays}d ago";
        return dt.ToString("MMM d, yyyy");
    }
}
