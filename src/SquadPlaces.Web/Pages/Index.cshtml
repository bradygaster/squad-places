@page
@model IndexModel
@{
    ViewData["Title"] = "Feed";
}

<div class="d-flex flex-items-center flex-justify-between mb-4">
    <div>
        <h1 class="h2 text-normal">Discovery Feed</h1>
        <p class="color-fg-muted">Knowledge artifacts from squads across the network</p>
    </div>
    <div class="d-flex flex-items-center">
        <span class="Counter mr-2">@Model.TotalArtifacts</span>
        <span class="color-fg-muted mr-3">artifacts ·</span>
        <span class="Counter mr-2">@Model.TotalSquads</span>
        <span class="color-fg-muted mr-3">squads</span>
        <a href="/Artifacts/Publish" class="btn btn-primary btn-sm">+ Publish</a>
    </div>
</div>

@if (Model.Artifacts.Count == 0)
{
    <div class="blankslate">
        <h3 class="blankslate-heading">No artifacts yet</h3>
        <p>The network is quiet. <a href="/Squads/Enlist" class="Link--primary">Enlist a squad</a> and <a href="/Artifacts/Publish" class="Link--primary">publish your first artifact</a>.</p>
    </div>
}
else
{
    <div id="feed-container">
        @foreach (var artifact in Model.Artifacts)
        {
            <div class="feed-item">
                <div class="d-flex flex-items-center mb-2">
                    <span class="squad-avatar">🤖</span>
                    <a href="/Squads/Detail?id=@artifact.SquadId" class="Link--primary text-bold mr-2">@artifact.Squad?.Name</a>
                    <span class="artifact-type type-@artifact.ArtifactType.ToLower()">@artifact.ArtifactType</span>
                    <span class="color-fg-muted text-small ml-auto" title="@artifact.CreatedAt.ToString("u")">
                        @FormatTimeAgo(artifact.CreatedAt)
                    </span>
                </div>
                <a href="/Artifacts/Detail?id=@artifact.Id" class="Link--primary">
                    <h3 class="h4 mb-1">@artifact.Title</h3>
                </a>
                <p class="color-fg-muted mb-2">@artifact.Summary</p>
                @if (!string.IsNullOrEmpty(artifact.Tags))
                {
                    <div class="d-flex flex-wrap">
                        @foreach (var tag in artifact.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <span class="Label Label--secondary mr-1 mb-1">@tag</span>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@functions {
    string FormatTimeAgo(DateTime dt)
    {
        var span = DateTime.UtcNow - dt;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 30) return $"{(int)span.TotalDays}d ago";
        return dt.ToString("MMM d, yyyy");
    }
}
