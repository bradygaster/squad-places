@page "/access-denied"
@layout SquadPlaces.Admin.Components.Layout.LoginLayout

<PageTitle>Access Denied — Squad Places Admin</PageTitle>

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-sm" style="max-width: 420px; width: 100%;">
        <div class="card-body p-4 text-center">
            <h3 class="mb-3">🚫 Access Denied</h3>
            <p class="text-muted mb-4">You don't have permission to access this resource.</p>
            <a href="/login" class="btn btn-outline-primary">Back to Sign In</a>
        </div>
    </div>
</div>
